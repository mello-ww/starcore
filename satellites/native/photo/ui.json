    "albums": {
      "offline": {"omit": ["location", "lat", "lon", "folder"]},
      "source": {"route": "gallery/albums"},
      "blocks": [
        {"type": "actions", "blocks": [
          {"type": "dropdown", "label": "Create album", "style": "primary", "blocks": [
            {"type": "form",
             "fields": [{"key": "name", "label": "Name", "kind": "text", "placeholder": "Holidays", "required": true}],
             "submit": {"label": "Create album",
                        "action": {"route": "albums", "body": {"name": "$form.name"}, "then": {"navigate": "album", "params": {"id": "$.id"}}}}}
          ]},
          {"type": "button", "label": "Phone backup", "style": "secondary", "action": {"navigate": "backup"}},
          {"type": "button", "label": "Settings", "style": "secondary", "action": {"navigate": "settings"}}
        ]},
        {
          "type": "media-grid",
          "id": "albums",
          "items": "$.albums",
          "size": "large",
          "empty": "No albums yet.",
          "item": {"image": "thumbnails/{$.cover}", "key": "$.id", "title": "$.title", "subtitle": "$.subtitle", "group": "$.group", "icon": "$.icon"},
          "open": [
            {"visible": "$.section", "action": {"section": "$.section"}},
            {"visible": "$.trash", "action": {"navigate": "trash"}},
            {"action": {"navigate": "album", "params": {"id": "$.id"}}}
          ]
        },
        {"type": "text", "style": "caption", "text": "$.folders_hint", "visible": "$.folders_hint"},
        {"type": "text", "style": "caption", "text": "$.albums_hint", "visible": "$.albums_hint"}
      ]
    },
    "backup": {
      "title": "Phone backup",
      "source": {"route": "gallery/backup"},
      "blocks": [
        {"type": "text", "style": "caption", "text": "$.note"},
        {"type": "button", "label": "Back up this phone", "style": "primary", "action": {"sync": {"capability": "media.sync"}}},
        {
          "type": "card",
          "title": "Devices",
          "blocks": [
            {"type": "text", "style": "caption", "text": "$.summary", "visible": "$.summary"},
            {
              "type": "list",
              "items": "$.devices",
              "empty": "No device has backed up here yet.",
              "item": {"title": "$.name", "subtitle": "$.last_seen", "value": "$.files", "format": {"subtitle": "relative"}}
            }
          ]
        }
      ]
    },
    "settings": {
      "title": "Settings",
      "source": {"route": "gallery/settings"},
      "blocks": [
        {
          "type": "card",
          "title": "Phone folders",
          "blocks": [
            {"type": "text", "style": "caption", "text": "Each phone folder synced into its own album, under its folder in the library. The folder in the library is never assumed to match the phone's."},
            {"type": "form",
             "fields": [{"key": "source_paths", "label": "Phone folders", "kind": "rows", "add": "Add a phone folder", "value": "$.source_paths",
                         "fields": [{"key": "phone_path", "label": "On the phone", "kind": "text", "placeholder": "/Pictures/Screenshots", "required": true},
                                    {"key": "server_path", "label": "In the library", "kind": "text", "placeholder": "screenshots", "required": true},
                                    {"key": "name", "label": "Album name", "kind": "text", "placeholder": "Screenshots"}]}],
             "submit": {"label": "Save phone folders",
                        "action": {"route": "configuration", "body": {"key": "source_paths", "value": "$form.source_paths"}, "then": "refresh"}}}
          ]
        },
        {
          "type": "card",
          "title": "Synced photos",
          "blocks": [
            {"type": "text", "style": "caption", "text": "Where a synced photo or video lands, and which album it joins, when its phone folder isn't one of the above."},
            {"type": "form",
             "fields": [{"key": "path", "label": "Default album folder", "kind": "text", "value": "$.sync_default_path", "placeholder": "camera", "required": true}],
             "submit": {"label": "Save",
                        "action": {"route": "configuration", "body": {"key": "sync_default_path", "value": "$form.path"}, "then": "refresh"}}}
          ]
        },
        {
          "type": "card",
          "title": "Recycle bin",
          "blocks": [
            {"type": "form",
             "fields": [{"key": "days", "label": "Days a deleted item is kept", "kind": "number", "value": "$.trash_retention_days", "required": true}],
             "submit": {"label": "Save",
                        "action": {"route": "configuration", "body": {"key": "trash_retention_days", "value": "$form.days"}, "then": "refresh"}}}
          ]
        },
        {
          "type": "card",
          "title": "Import",
          "blocks": [
            {"type": "text", "style": "caption", "text": "The folder on the StarCore server an import starts from. Leave it empty to name one each time."},
            {"type": "form",
             "fields": [{"key": "directory", "label": "Default folder", "kind": "text", "value": "$.photo_directory", "placeholder": "/absolute/path"}],
             "submit": {"label": "Save",
                        "action": {"route": "configuration", "body": {"key": "photo_directory", "value": "$form.directory"}, "then": "refresh"}}}
          ]
        }
      ]
    },
