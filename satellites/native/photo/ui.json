{
  "_about": "Photo's shared interface (UI contract 1.2): Library, Albums, Search, Map, the recycle bin and import from a server folder, in the shared media-grid, viewer, search and map. A preview: both clients keep opening Photo's own screens, and Developer Mode shows this one beside them, until it reaches parity (docs/satellites/photo.md, \"Shared interface\"). Phone sync, settings, moving to the Locked Folder and the Locked Folder itself stay on Photo's own screens. It binds to the read-only gallery routes (gallery.py); every action goes to Photo's existing routes.",
  "contract": "starcore.ui/1.2",
  "preview": true,
  "title": "Photos",
  "entry": "library",
  "navigation": [
    {"page": "library", "label": "Library", "icon": "image"},
    {"page": "albums", "label": "Albums", "icon": "folder"},
    {"page": "search", "label": "Search", "icon": "search"},
    {"page": "map", "label": "Map", "icon": "map-pin"}
  ],
  "pages": {
    "library": {
      "source": {"route": "gallery?limit=120"},
      "blocks": [
        {"type": "text", "style": "caption", "text": "$.summary"},
        {"type": "button", "label": "Import from a folder", "style": "secondary", "action": {"navigate": "import"}},
        {
          "type": "media-grid",
          "id": "library",
          "items": "$.items",
          "more": {"route": "gallery?limit=120&cursor={$value}", "cursor": "$.next"},
          "size": "medium",
          "empty": "No photos yet. Import a folder, or turn on phone sync in Photo's settings.",
          "item": {"image": "thumbnails/{$.id}", "key": "$.id", "kind": "$.kind", "duration": "$.duration", "group": "$.month"},
          "viewer": {
            "image": "originals/{$.id}",
            "video": "originals/{$.id}",
            "title": "$.title",
            "subtitle": "$.date",
            "fields": [
              {"label": "Taken", "value": "$.taken", "format": "datetime"},
              {"label": "Length", "value": "$.duration", "format": "duration"},
              {"label": "Size", "value": "$.size", "format": "bytes"},
              {"label": "Dimensions", "value": "$.dimensions"},
              {"label": "Resolution", "value": "$.megapixels"},
              {"label": "Format", "value": "$.format"},
              {"label": "Camera", "value": "$.camera"},
              {"label": "Lens", "value": "$.lens"},
              {"label": "Location", "value": "$.location"},
              {"label": "Folder", "value": "$.folder"},
              {"label": "File", "value": "$.title"},
              {"label": "Imported", "value": "$.imported", "format": "datetime"}
            ],
            "actions": [
              {"label": "Favorite", "icon": "heart", "visible": "$.can_favorite",
               "action": {"route": "albums/favorites/photos", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Unfavorite", "icon": "heart", "style": "primary", "visible": "$.favorite",
               "action": {"route": "albums/favorites/photos/remove", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Move to bin", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}", "confirm": "Move this to the recycle bin? It can be restored from there.", "then": "refresh"}}
            ]
          },
          "selection": {
            "actions": [
              {"label": "Favorite", "icon": "heart",
               "action": {"route": "albums/favorites/photos", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Move to bin", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}", "confirm": "Move the selected items to the recycle bin? They can be restored from there.", "then": "refresh"}}
            ]
          }
        }
      ]
    },
    "search": {
      "state": {"q": "", "kind": "all"},
      "source": {"route": "gallery/search?q={$state.q}&kind={$state.kind}&limit=120"},
      "blocks": [
        {"type": "search", "key": "q", "label": "Search", "placeholder": "Search filenames, camera, date…"},
        {"type": "choice", "key": "kind", "label": "Show",
         "options": [{"value": "all", "label": "All"}, {"value": "image", "label": "Photos"}, {"value": "video", "label": "Videos"}]},
        {"type": "text", "style": "caption", "text": "$.prompt", "visible": "$.prompt"},
        {"type": "text", "style": "caption", "text": "$.summary", "visible": "$.summary"},
        {"type": "media-list", "id": "search-albums", "items": "$.albums", "visible": "$.albums", "size": "medium",
         "item": {"title": "$.title", "subtitle": "$.subtitle", "image": "thumbnails/{$.cover}"},
         "action": {"navigate": "album", "params": {"id": "$.id"}}},
        {
          "type": "media-grid",
          "id": "search-results",
          "visible": "$.items",
          "items": "$.items",
          "more": {"route": "gallery/search?q={$state.q}&kind={$state.kind}&limit=120&cursor={$value}", "cursor": "$.next"},
          "size": "medium",
          "item": {"image": "thumbnails/{$.id}", "key": "$.id", "kind": "$.kind", "duration": "$.duration"},
          "viewer": {
            "image": "originals/{$.id}",
            "video": "originals/{$.id}",
            "title": "$.title",
            "subtitle": "$.date",
            "fields": [
              {"label": "Taken", "value": "$.taken", "format": "datetime"},
              {"label": "Length", "value": "$.duration", "format": "duration"},
              {"label": "Size", "value": "$.size", "format": "bytes"},
              {"label": "Dimensions", "value": "$.dimensions"},
              {"label": "Resolution", "value": "$.megapixels"},
              {"label": "Format", "value": "$.format"},
              {"label": "Camera", "value": "$.camera"},
              {"label": "Lens", "value": "$.lens"},
              {"label": "Location", "value": "$.location"},
              {"label": "Folder", "value": "$.folder"},
              {"label": "File", "value": "$.title"},
              {"label": "Imported", "value": "$.imported", "format": "datetime"}
            ],
            "actions": [
              {"label": "Favorite", "icon": "heart", "visible": "$.can_favorite",
               "action": {"route": "albums/favorites/photos", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Unfavorite", "icon": "heart", "style": "primary", "visible": "$.favorite",
               "action": {"route": "albums/favorites/photos/remove", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Move to bin", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}", "confirm": "Move this to the recycle bin? It can be restored from there.", "then": "refresh"}}
            ]
          }
        }
      ]
    },
    "map": {
      "source": {"route": "gallery/map?overview=1"},
      "blocks": [
        {"type": "text", "style": "caption", "text": "$.summary", "visible": "$.summary"},
        {
          "type": "map",
          "id": "places",
          "items": "$.items",
          "bounds": "$.bounds",
          "viewport": {"route": "gallery/map?bbox={$value.bbox}&zoom={$value.zoom}"},
          "empty": "No photos have location data yet. Photos with GPS metadata will appear here automatically.",
          "item": {"lat": "$.lat", "lon": "$.lon", "key": "$.id", "image": "thumbnails/{$.cover}", "title": "$.title", "kind": "$.kind",
                   "count": "$.count", "bounds": "$.bounds"},
          "viewer": {
            "image": "originals/{$.id}",
            "video": "originals/{$.id}",
            "title": "$.title",
            "subtitle": "$.date",
            "fields": [
              {"label": "Taken", "value": "$.taken", "format": "datetime"},
              {"label": "Length", "value": "$.duration", "format": "duration"},
              {"label": "Size", "value": "$.size", "format": "bytes"},
              {"label": "Dimensions", "value": "$.dimensions"},
              {"label": "Resolution", "value": "$.megapixels"},
              {"label": "Format", "value": "$.format"},
              {"label": "Camera", "value": "$.camera"},
              {"label": "Lens", "value": "$.lens"},
              {"label": "Location", "value": "$.location"},
              {"label": "Folder", "value": "$.folder"},
              {"label": "File", "value": "$.title"},
              {"label": "Imported", "value": "$.imported", "format": "datetime"}
            ],
            "actions": [
              {"label": "Favorite", "icon": "heart", "visible": "$.can_favorite",
               "action": {"route": "albums/favorites/photos", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Unfavorite", "icon": "heart", "style": "primary", "visible": "$.favorite",
               "action": {"route": "albums/favorites/photos/remove", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Move to bin", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}", "confirm": "Move this to the recycle bin? It can be restored from there.", "then": "refresh"}}
            ]
          }
        }
      ]
    },
    "albums": {
      "source": {"route": "gallery/albums"},
      "blocks": [
        {
          "type": "media-grid",
          "id": "albums",
          "items": "$.albums",
          "size": "large",
          "empty": "No albums yet.",
          "item": {"image": "thumbnails/{$.cover}", "key": "$.id", "title": "$.title", "subtitle": "$.subtitle", "group": "$.group"},
          "action": {"navigate": "album", "params": {"id": "$.id"}}
        },
        {
          "type": "card",
          "title": "New album",
          "blocks": [
            {"type": "form",
             "fields": [{"key": "name", "label": "Name", "kind": "text", "placeholder": "Holidays", "required": true}],
             "submit": {"label": "Create album",
                        "action": {"route": "albums", "body": {"name": "$form.name"}, "then": {"navigate": "album", "params": {"id": "$.id"}}}}}
          ]
        },
        {"type": "button", "label": "Recycle bin", "style": "secondary", "action": {"navigate": "trash"}}
      ]
    },
    "album": {
      "title": "$.name",
      "params": ["id"],
      "source": {"route": "gallery/albums/{$params.id}?limit=120"},
      "blocks": [
        {"type": "text", "style": "caption", "text": "$.summary"},
        {"type": "text", "style": "caption", "text": "$.description", "visible": "$.description"},
        {"type": "button", "label": "Add photos", "style": "primary", "visible": "$.editable",
         "action": {"pick": {"capability": "media.gallery", "multiple": true, "title": "Add to album"},
                    "route": "albums/{$params.id}/photos", "body": {"items": "$value"}, "then": "refresh"}},
        {
          "type": "media-grid",
          "id": "album",
          "items": "$.items",
          "more": {"route": "gallery/albums/{$params.id}?limit=120&cursor={$value}", "cursor": "$.next"},
          "size": "medium",
          "empty": "This album is empty.",
          "item": {"image": "thumbnails/{$.id}", "key": "$.id", "kind": "$.kind", "duration": "$.duration"},
          "viewer": {
            "image": "originals/{$.id}",
            "video": "originals/{$.id}",
            "title": "$.title",
            "subtitle": "$.date",
            "fields": [
              {"label": "Taken", "value": "$.taken", "format": "datetime"},
              {"label": "Length", "value": "$.duration", "format": "duration"},
              {"label": "Size", "value": "$.size", "format": "bytes"},
              {"label": "Dimensions", "value": "$.dimensions"},
              {"label": "Format", "value": "$.format"},
              {"label": "Camera", "value": "$.camera"},
              {"label": "Location", "value": "$.location"},
              {"label": "File", "value": "$.title"}
            ],
            "actions": [
              {"label": "Favorite", "icon": "heart", "visible": "$.can_favorite",
               "action": {"route": "albums/favorites/photos", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Unfavorite", "icon": "heart", "style": "primary", "visible": "$.favorite",
               "action": {"route": "albums/favorites/photos/remove", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Remove from album", "icon": "x", "visible": "$.removable",
               "action": {"route": "albums/{$params.id}/photos/remove", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Move to bin", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}", "confirm": "Move this to the recycle bin? It can be restored from there.", "then": "refresh"}}
            ]
          },
          "selection": {
            "actions": [
              {"label": "Move to bin", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}", "confirm": "Move the selected items to the recycle bin? They can be restored from there.", "then": "refresh"}}
            ]
          }
        },
        {
          "type": "card",
          "title": "Album",
          "visible": "$.editable",
          "blocks": [
            {"type": "form",
             "fields": [{"key": "name", "label": "Name", "kind": "text", "value": "$.name", "required": true}],
             "submit": {"label": "Rename", "action": {"route": "albums/{$params.id}", "body": {"name": "$form.name"}, "then": "refresh"}}},
            {"type": "button", "label": "Delete album", "style": "danger",
             "action": {"route": "albums/{$params.id}/delete", "confirm": "Delete this album? The photos in it stay in your library.", "then": "back"}}
          ]
        }
      ]
    },
    "import": {
      "title": "Import from a folder",
      "source": {"route": "gallery/import"},
      "blocks": [
        {"type": "text", "style": "caption", "text": "$.formats"},
        {
          "type": "card",
          "title": "Check a folder",
          "blocks": [
            {"type": "text", "style": "caption", "text": "Counts what a folder holds and what is new, without importing anything."},
            {"type": "form",
             "fields": [{"key": "source", "label": "Folder on the StarCore server", "kind": "text", "value": "$.directory",
                         "placeholder": "/absolute/path", "required": true}],
             "submit": {"label": "Check", "action": {"route": "scan", "body": {"source": "$form.source"}}}}
          ]
        },
        {
          "type": "card",
          "title": "Import a folder",
          "blocks": [
            {"type": "text", "style": "caption", "text": "Copies the folder's photos and videos into the library."},
            {"type": "form",
             "fields": [{"key": "source", "label": "Folder on the StarCore server", "kind": "text", "value": "$.directory",
                         "placeholder": "/absolute/path", "required": true}],
             "submit": {"label": "Import", "action": {"route": "import", "body": {"source": "$form.source"}}}}
          ]
        }
      ]
    },
    "trash": {
      "title": "Recycle bin",
      "source": {"route": "gallery/trash?limit=120"},
      "blocks": [
        {"type": "text", "style": "caption", "text": "$.note"},
        {
          "type": "media-grid",
          "id": "trash",
          "items": "$.items",
          "more": {"route": "gallery/trash?limit=120&cursor={$value}", "cursor": "$.next"},
          "size": "medium",
          "empty": "The recycle bin is empty.",
          "item": {"image": "trash/{$.id}/thumbnail", "key": "$.id", "kind": "$.kind", "duration": "$.duration", "subtitle": "$.left"},
          "viewer": {
            "image": "trash/{$.id}/original",
            "video": "trash/{$.id}/original",
            "title": "$.title",
            "subtitle": "$.date",
            "fields": [
              {"label": "Moved here", "value": "$.trashed", "format": "datetime"},
              {"label": "Remaining", "value": "$.left"},
              {"label": "Taken", "value": "$.taken", "format": "datetime"},
              {"label": "Size", "value": "$.size", "format": "bytes"},
              {"label": "File", "value": "$.title"}
            ],
            "actions": [
              {"label": "Restore", "icon": "rotate-ccw", "style": "primary",
               "action": {"route": "trash/{$.id}/restore", "then": "refresh"}},
              {"label": "Delete forever", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}/erase", "confirm": "Delete this for good? This can't be undone.", "then": "refresh"}}
            ]
          },
          "selection": {
            "actions": [
              {"label": "Restore", "icon": "rotate-ccw",
               "action": {"route": "trash/{$.id}/restore", "then": "refresh"}},
              {"label": "Delete forever", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}/erase", "confirm": "Delete the selected items for good? This can't be undone.", "then": "refresh"}}
            ]
          }
        }
      ]
    }
  }
}
