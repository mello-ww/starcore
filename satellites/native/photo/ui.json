{
  "_about": "Photo's shared interface (UI contract 1.2): Library, Albums, Search, Map, the recycle bin and import from a server folder, in the shared media-grid, viewer, search and map. Both clients open it by default; Photo's own page and screens stay in Developer Mode until it is validated (docs/satellites/photo.md, \"Shared interface\"). Library, Albums and an album are kept to show while StarCore can't be reached (\"offline\"); the recycle bin, Search and Map are not. Settings (Albums' Settings button) edits Photo's own settings as forms, each saved through the configuration route: the phone folder -> server path mappings as repeatable rows (each keeping its id, so its album keeps its own), the recycle bin's retention, the default import folder and the folder synced photos land in. Phone backup (Albums' Phone backup button) lists the devices that back up here (gallery/backup) and offers the sync action: it opens the client's own sync screen for Photo's media.sync, and a client without one (Mission Control, and the app until docs/archive/photos-parity-audit.md's S3) hides the button. The Satellites Photo hosts (section_of) are folders among the others: gallery/albums lists them from the Engine's registry, with their own title and icon, and a tile opens one through the section action: its own shared interface, by itself, behind its own unlock. Moving photos into the Locked Folder runs here, from the viewer and a selection, through the secure action: the client's own unlock prompt asks the media.vault provider for a single-use grant for exactly those photos, so the Locked Folder never opens. It binds to the read-only gallery routes (gallery.py); every action goes to Photo's existing routes.",
  "contract": "starcore.ui/1.2",
  "title": "Photos",
  "entry": "library",
  "navigation": [
    {"page": "library", "label": "Library", "icon": "image"},
    {"page": "albums", "label": "Albums", "icon": "albums"},
    {"page": "search", "label": "Search", "icon": "search"},
    {"page": "map", "label": "Map", "icon": "map-pin"}
  ],
  "pages": {
    "library": {
      "offline": {"omit": ["location", "lat", "lon", "folder"]},
      "state": {"group": "month"},
      "source": {"route": "gallery?limit=120&group={$state.group}"},
      "blocks": [
        {"type": "text", "style": "caption", "text": "$.summary"},
        {"type": "text", "style": "caption", "text": "$.tools", "visible": "$.tools"},
        {"type": "button", "label": "Import from a folder", "style": "secondary", "action": {"navigate": "import"}},
        {"type": "choice", "key": "group", "label": "Group by",
         "options": [{"value": "month", "label": "Month"}, {"value": "camera", "label": "Camera"}, {"value": "all", "label": "All"}]},
        {
          "type": "media-grid",
          "id": "library",
          "items": "$.items",
          "more": {"route": "gallery?limit=120&group={$state.group}&cursor={$value}", "cursor": "$.next"},
          "size": "medium",
          "empty": "No photos yet. Import a folder from the server.",
          "item": {"image": "thumbnails/{$.id}", "key": "$.id", "kind": "$.kind", "duration": "$.duration", "group": "$.group"},
          "quick": [
            {"label": "Favorite", "icon": "heart", "visible": "$.can_favorite",
             "action": {"route": "albums/favorites/photos", "body": {"photo_id": "$.id"}, "then": "refresh"}},
            {"label": "Unfavorite", "icon": "heart", "style": "primary", "visible": "$.favorite",
             "action": {"route": "albums/favorites/photos/remove", "body": {"photo_id": "$.id"}, "then": "refresh"}}
          ],
          "viewer": {
            "image": "originals/{$.id}",
            "video": "originals/{$.id}",
            "title": "$.title",
            "subtitle": "$.date",
            "fields": [
              {"label": "Taken", "value": "$.taken", "format": "datetime"},
              {"label": "Length", "value": "$.duration", "format": "duration"},
              {"label": "Size", "value": "$.size", "format": "bytes"},
              {"label": "Dimensions", "value": "$.resolution"},
              {"label": "Exposure", "value": "$.exposure"},
              {"label": "Format", "value": "$.format"},
              {"label": "Camera", "value": "$.camera"},
              {"label": "Lens", "value": "$.lens"},
              {"label": "Location", "value": "$.location", "href": "https://www.openstreetmap.org/?mlat={$.lat}&mlon={$.lon}#map=16/{$.lat}/{$.lon}"},
              {"label": "Folder", "value": "$.folder", "action": {"locate": "$.folder"}},
              {"label": "File", "value": "$.title"},
              {"label": "Imported", "value": "$.imported", "format": "datetime"}
            ],
            "actions": [
              {"label": "Favorite", "icon": "heart", "visible": "$.can_favorite",
               "action": {"route": "albums/favorites/photos", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Unfavorite", "icon": "heart", "style": "primary", "visible": "$.favorite",
               "action": {"route": "albums/favorites/photos/remove", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Download", "icon": "download", "action": {"download": "originals/{$.id}", "name": "$.title"}},
              {"label": "Share", "icon": "share-2", "action": {"share": "originals/{$.id}", "name": "$.title"}},
              {"label": "Show in folder", "icon": "folder", "visible": "$.folder", "action": {"locate": "$.folder"}},
              {"label": "Move to Locked Folder", "icon": "lock",
               "action": {"secure": {"capability": "media.vault", "operation": "move_in"}, "item": "$.id", "confirm": "Move this to the Locked Folder? It leaves Photos and stays behind your PIN.", "then": "refresh"}},
              {"label": "Move to bin", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}", "confirm": "Move this to the recycle bin? It can be restored from there.", "then": "refresh"}}
            ]
          },
          "selection": {
            "actions": [
              {"label": "Favorite", "icon": "heart",
               "action": {"route": "albums/favorites/photos", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Unfavorite", "icon": "heart",
               "action": {"route": "albums/favorites/photos/remove", "body": {"photo_id": "$.id"}, "then": "refresh"}},
              {"label": "Move to Locked Folder", "icon": "lock",
               "action": {"secure": {"capability": "media.vault", "operation": "move_in"}, "item": "$.id", "confirm": "Move the selected items to the Locked Folder? They leave Photos and stay behind your PIN.", "then": "refresh"}},
              {"label": "Move to bin", "icon": "trash-2", "style": "danger",
               "action": {"route": "trash/{$.id}", "confirm": "Move the selected items to the recycle bin? They can be restored from there.", "then": "refresh"}}
            ]
          }
        }
      ]
    },
