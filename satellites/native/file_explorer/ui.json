{
  "_about": "File Explorer's shared interface (UI contract 1.2), a preview while it reaches parity with the web page (docs/file-explorer-migration.md): Mission Control keeps page.js by default and offers this in Developer Mode; the Android app, which has no File Explorer screen of its own, opens it. F1 browses read-only: the locations with their storage, and each folder's folders and files. F2 pages them: each list loads 200 rows at a time (`more`). F3 opens a file's page: its details, a picture's preview, and Open, Download and Share from the `content` route. F4 manages: new folder, rename and delete (with a confirm) through the `mkdir`, `rename` and `delete` routes, behind the same guards as the web page. The pages bind to the read-only view routes (views.py).",
  "contract": "starcore.ui/1.2",
  "title": "Files",
  "preview": true,
  "entry": "locations",
  "pages": {
    "locations": {
      "title": "Locations",
      "source": {"route": "view/locations"},
      "blocks": [
        {"type": "card", "title": "This machine", "visible": "$.machine", "blocks": [
          {"type": "metric", "label": "Used", "value": "$.machine.used", "max": "$.machine.total", "format": "bytes"},
          {"type": "text", "style": "caption", "text": "$.machine_summary"}
        ]},
        {"type": "list", "items": "$.drives", "empty": "No location can be browsed.",
         "item": {"title": "$.title", "subtitle": "$.summary", "value": "$.used_percent", "format": {"value": "percent"}, "icon": "hard-drive"},
         "action": {"navigate": "folder", "params": {"path": "$.path"}}}
      ]
    },
    "folder": {
      "title": "$.name",
      "params": ["path"],
      "source": {"route": "view/folder?path={$params.path}"},
      "blocks": [
        {"type": "text", "style": "mono", "text": "$.path"},
        {"type": "text", "style": "caption", "text": "$.summary"},
        {"type": "button", "label": "Up", "style": "secondary", "visible": "$.parent",
         "action": {"navigate": "folder", "params": {"path": "$.parent"}}},
        {"type": "button", "label": "All locations", "style": "secondary", "visible": "$.at_drive_root",
         "action": {"navigate": "locations"}},
        {"type": "text", "style": "caption", "text": "This folder is empty.", "visible": "$.empty"},
        {"type": "list", "id": "folders", "visible": "$.has_folders", "items": "$.folders",
         "item": {"title": "$.name", "subtitle": "$.subtitle", "format": {"subtitle": "datetime"}, "icon": "$.icon"},
         "action": {"navigate": "folder", "params": {"path": "$.path"}},
         "more": {"route": "view/folder?path={$params.path}&part=folders&cursor={$value}", "cursor": "$.folders_next"}},
        {"type": "list", "id": "files", "visible": "$.has_files", "items": "$.files",
         "item": {"title": "$.name", "subtitle": "$.modified", "value": "$.size", "format": {"subtitle": "datetime", "value": "bytes"}, "icon": "$.icon"},
         "action": {"navigate": "file", "params": {"path": "$.path"}},
         "more": {"route": "view/folder?path={$params.path}&part=files&cursor={$value}", "cursor": "$.files_next"}},
        {"type": "text", "style": "caption", "text": "$.storage", "visible": "$.storage"},
        {"type": "card", "title": "New folder", "blocks": [
          {"type": "form",
           "fields": [{"key": "folder", "label": "Name", "kind": "text", "placeholder": "Folder name", "required": true}],
           "submit": {"label": "Create folder",
                      "action": {"route": "mkdir", "body": {"path": "$params.path", "name": "$form.folder"}, "then": "refresh"}}}
        ]},
        {"type": "card", "title": "This folder", "visible": "$.parent", "blocks": [
          {"type": "form",
           "fields": [{"key": "name", "label": "Name", "kind": "text", "value": "$.name", "required": true}],
           "submit": {"label": "Rename",
                      "action": {"route": "rename", "body": {"path": "$params.path", "name": "$form.name"}, "then": "back"}}},
          {"type": "button", "label": "Delete this folder", "style": "danger",
           "action": {"route": "delete", "body": {"path": "$params.path"},
                      "confirm": "Delete this folder and everything in it? This cannot be undone.", "then": "back"}}
        ]}
      ]
    },
    "file": {
      "title": "$.name",
      "params": ["path"],
      "source": {"route": "view/file?path={$params.path}"},
      "blocks": [
        {"type": "image", "visible": "$.preview", "src": "content?path={$params.path}", "alt": "$.name",
         "size": "full", "shape": "wide", "fit": "contain"},
        {"type": "card", "blocks": [
          {"type": "field", "label": "Size", "value": "$.size", "format": "bytes"},
          {"type": "field", "label": "Modified", "value": "$.modified", "format": "datetime"},
          {"type": "field", "label": "Type", "value": "$.kind"},
          {"type": "field", "label": "Folder", "value": "$.folder"}
        ]},
        {"type": "button", "label": "Open", "style": "primary",
         "action": {"download": "content?path={$params.path}", "name": "$.name", "open": true}},
        {"type": "button", "label": "Download", "style": "secondary",
         "action": {"download": "content?path={$params.path}&download=1", "name": "$.name"}},
        {"type": "button", "label": "Share", "style": "secondary",
         "action": {"share": "content?path={$params.path}", "name": "$.name"}},
        {"type": "card", "title": "Manage", "blocks": [
          {"type": "form",
           "fields": [{"key": "name", "label": "Name", "kind": "text", "value": "$.name", "required": true}],
           "submit": {"label": "Rename",
                      "action": {"route": "rename", "body": {"path": "$params.path", "name": "$form.name"}, "then": "back"}}},
          {"type": "button", "label": "Delete this file", "style": "danger",
           "action": {"route": "delete", "body": {"path": "$params.path"},
                      "confirm": "Delete this file? This cannot be undone.", "then": "back"}}
        ]}
      ]
    }
  }
}
