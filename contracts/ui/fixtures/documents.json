    {
      "name": "every-block",
      "document": {
        "contract": "starcore.ui/1.0",
        "title": "Every block",
        "requires": {"client": [], "capabilities": ["files.browse"]},
        "entry": "home",
        "navigation": [{"page": "home", "label": "Home", "icon": "home"}, {"page": "rows", "label": "Rows", "icon": "list"}],
        "pages": {
          "home": {
            "title": "Home",
            "source": {"route": "summary", "refresh": 5},
            "blocks": [
              {"type": "heading", "text": "$.name"},
              {"type": "text", "text": "Caption", "style": "caption"},
              {"type": "field", "label": "Count", "value": "$.count", "format": "integer", "tone": "$.tone"},
              {"type": "metric", "label": "Level", "value": "$.level", "format": "percent", "max": 100},
              {"type": "card", "title": "Controls", "blocks": [
                {"type": "toggle", "label": "On", "value": "$.on", "action": {"route": "settings", "body": {"on": "$value"}, "then": "refresh"}},
                {"type": "slider", "label": "Level", "value": "$.level", "min": 0, "max": 100, "step": 5, "unit": "%",
                 "action": {"route": "settings", "body": {"level": "$value"}}},
                {"type": "button", "label": "Reset", "style": "danger", "action": {"route": "reset", "confirm": "Reset?", "then": "refresh"}}
              ]},
              {"type": "form", "fields": [
                {"key": "title", "label": "Title", "kind": "text", "required": true, "placeholder": "Name"},
                {"key": "size", "label": "Size", "kind": "select", "options": [{"value": "s", "label": "Small"}, {"value": "l", "label": "Large"}]},
                {"key": "n", "label": "N", "kind": "number"},
                {"key": "flag", "label": "Flag", "kind": "toggle", "value": true}
              ], "submit": {"label": "Add", "action": {"route": "rows", "body": {"title": "$form.title"}, "then": {"navigate": "row", "params": {"id": "$.id"}}}}},
              {"type": "file-browser", "capability": "files.browse", "select": "directory", "label": "Pick a folder",
               "action": {"route": "selection", "body": {"path": "$value"}, "then": "refresh"}},
              {"type": "text", "text": "Shown in Developer Mode", "developer": true, "visible": "$.debug"}
            ]
          },
          "rows": {
            "title": "Rows",
            "source": {"route": "rows"},
            "blocks": [
              {"type": "list", "items": "$.rows", "empty": "Nothing yet.",
               "item": {"title": "$.title", "subtitle": "$.updated", "value": "$.size", "format": {"value": "bytes"}, "icon": "file"},
               "action": {"navigate": "row", "params": {"id": "$.id"}}}
            ]
          },
          "row": {
            "title": "$.title",
            "params": ["id"],
            "source": {"route": "rows/{$params.id}"},
            "blocks": [
              {"type": "field", "label": "Id", "value": "$params.id"},
              {"type": "button", "label": "Delete", "style": "danger", "action": {"route": "rows/{$params.id}/delete", "method": "POST", "confirm": "Delete?", "then": "back"}}
            ]
          }
        }
      }
    },
    {"name": "every-1.1-feature", "document": {"contract": "starcore.ui/1.1", "title": "System", "entry": "overview", "header": {"source": {"route": "view", "refresh": 5}, "blocks": [{"type": "text", "style": "eyebrow", "text": "$.node"}, {"type": "heading", "text": "System"}, {"type": "status", "label": "$.health.label", "tone": "$.health.tone", "detail": "$.health.detail"}]}, "widgets": [{"id": "summary", "title": "Summary", "icon": "activity", "blocks": [{"type": "metric", "label": "CPU", "value": "$.cpu", "format": "percent", "max": 100}], "action": {"navigate": "overview"}}], "navigation": [{"page": "overview", "label": "Overview", "icon": "activity"}, {"page": "diag", "label": "Diagnostics", "developer": true}], "pages": {"overview": {"template": "dashboard", "source": {"route": "view", "refresh": 5}, "sources": {"trend": {"route": "history?period=1h", "refresh": 30}}, "blocks": [{"type": "metric", "label": "CPU", "value": "$.cpu", "format": "percent", "max": 100, "tone": "$.cpu_tone", "detail": "$.cpu_detail", "trend": "$sources.trend.series.cpu.points", "action": {"navigate": "diag"}}, {"type": "field", "label": "Booted", "value": "$.boot", "format": "datetime", "detail": "$.uptime"}, {"type": "chart", "title": "CPU", "series": [{"label": "CPU", "points": "$sources.trend.series.cpu.points"}], "format": "percent", "max": 100, "from": "$sources.trend.from", "to": "$sources.trend.to", "resolution": "$sources.trend.resolution", "empty": "No samples yet"}, {"type": "chart", "kind": "bars", "series": [{"label": "Per thread", "points": "$.per_core"}], "format": "percent", "max": 100}, {"type": "table", "rows": "$.drives", "empty": "No drives", "columns": [{"label": "Drive", "value": "$.mount"}, {"label": "Used", "value": "$.percent", "format": "percent", "max": 100, "align": "end", "tone": "$.tone"}]}, {"type": "list", "items": "$.warnings", "item": {"title": "$.title", "subtitle": "$.detail", "value": "$.level", "tone": "$.tone"}, "empty": "No warnings."}]}, "diag": {"state": {"period": "24h"}, "source": {"route": "history?period={$state.period}"}, "blocks": [{"type": "choice", "key": "period", "label": "Range", "options": [{"value": "1h", "label": "1 hour"}, {"value": "24h", "label": "24 hours"}]}, {"type": "text", "text": "$state.period", "style": "mono"}, {"type": "code", "value": "$", "label": "Raw", "copy": true}]}}}}
