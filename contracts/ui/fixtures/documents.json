    {
      "name": "smallest",
      "document": {"contract": "starcore.ui/1.0", "entry": "home", "pages": {"home": {"blocks": []}}}
    },
    {
      "name": "newer-minor-with-unknown-block",
      "_why": "A Satellite written for 1.4 still loads on an Engine and clients that know 1.0: blocks they don't know are skipped.",
      "document": {"contract": "starcore.ui/1.4", "entry": "home", "pages": {"home": {"blocks": [
        {"type": "heading", "text": "Hi"},
