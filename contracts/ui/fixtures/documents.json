": {"state": {"period": "24h"}, "source": {"route": "history?period={$state.period}"}, "blocks": [{"type": "choice", "key": "period", "label": "Range", "options": [{"value": "1h", "label": "1 hour"}, {"value": "24h", "label": "24 hours"}]}, {"type": "text", "text": "$state.period", "style": "mono"}, {"type": "code", "value": "$", "label": "Raw", "copy": true}]}}}}
