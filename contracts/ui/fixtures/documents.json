    {
      "name": "media-blocks",
      "_why": "1.2: an image and a media-list, both loaded from the Satellite's own routes.",
      "document": {"contract": "starcore.ui/1.2", "entry": "home", "pages": {"home": {"blocks": [
        {"type": "image", "src": "covers/{$.id}?size=600", "alt": "$.title", "caption": "$.title", "size": "large", "shape": "square", "fit": "cover"},
        {"type": "image", "src": "banner", "size": "full", "shape": "wide", "fit": "contain"},
        {"type": "media-list", "items": "$.entries", "size": "medium", "shape": "round", "empty": "Nothing yet.",
         "item": {"title": "$.title", "subtitle": "$.added", "meta": "$.size", "image": "thumbs/{$.id}", "format": {"subtitle": "relative", "meta": "bytes"}},
         "action": {"navigate": "home"}},
        {"type": "media-list", "items": [{"title": "One"}], "item": {"title": "$.title"}}
      ]}}}
    },
    {
      "name": "media-grid",
      "_why": "1.2: a gallery of images and videos from the Satellite's own routes, grouped, with the shared viewer and selection; a preview document, so a client with the Satellite's own interface keeps it.",
      "document": {"contract": "starcore.ui/1.2", "preview": true, "entry": "home", "pages": {
        "home": {"source": {"route": "items"}, "blocks": [
          {"type": "media-grid", "items": "$.items", "size": "medium", "empty": "Nothing here yet.",
           "item": {"image": "thumbs/{$.id}", "key": "$.id", "kind": "$.kind", "duration": "$.seconds",
                    "group": "$.month", "title": "$.name", "subtitle": "$.taken", "format": {"subtitle": "date"}},
           "viewer": {"image": "full/{$.id}", "video": "play/{$.id}", "title": "$.name", "subtitle": "$.taken",
                      "fields": [{"label": "Taken", "value": "$.taken", "format": "datetime"}, {"label": "Size", "value": "$.bytes", "format": "bytes"}],
                      "actions": [{"label": "Favorite", "icon": "heart", "visible": "$.can_favorite", "action": {"route": "favorites", "body": {"id": "$.id"}, "then": "refresh"}},
                                  {"label": "Delete", "icon": "trash-2", "style": "danger", "action": {"route": "items/{$.id}/delete", "confirm": "Delete it?", "then": "refresh"}}]},
           "selection": {"actions": [{"label": "Delete", "icon": "trash-2", "style": "danger", "action": {"route": "items/{$.id}/delete", "confirm": "Delete the selected items?", "then": "refresh"}}]}},
          {"type": "media-grid", "items": [{"id": "a"}], "item": {"image": "thumbs/{$.id}"}, "shape": "wide", "size": "large",
